---
import { getI18N } from '../i18n/utils';

interface Props {
    title: string;
}

const i18n = getI18N({ currentLocale: 'es' });
const { title } = Astro.props;
---

<h2
    class="flex items-center mb-16 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white relative"
>
    <slot name="icon" />
    <span class="relative inline-block">
        <span class="relative z-10" data-i18n-key={`sections.${title}`}>
            {i18n.sections[title as keyof typeof i18n.sections]}
        </span>
        <span
            class="absolute inset-0 top-4 w-full h-8"
            style="background: url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 424 24%27 fill=%27%23FCD34D%27%3E%3Cpath d=%27M6 14.5c68.5-3.5 137-3.5 205.5-3.5 71.2 0 137.7 0 206.5 4 1.5-2.5 2.5-4.7 3-6.7.5-2-1-4.3-2-5.8-2.5 0-5 1.5-7.5 2-68.8-4 -137.3-4-206.5-4C137 .5 68.5.5 0 4c2 3.3 4 7 6 10.5z%27 stroke=%27%23FCD34D%27 stroke-width=%2711%27 stroke-opacity=%270.8%27 fill-opacity=%270%27/%3E%3C/svg%3E');
            background-size: 100% 100%;
            background-repeat: no-repeat;
            transform: rotate(-1deg);"
        ></span>
    </span>
</h2>

<script>
    const updateSectionTitles = () => {
        const currentLocale = localStorage.getItem('language') || 'es';

        import(`../i18n/${currentLocale}.json`).then((translations) => {
            const i18n = translations.default;

            document.querySelectorAll('[data-i18n-key^="sections."]').forEach((element) => {
                const key = element.getAttribute('data-i18n-key');
                if (!key) return;

                const keys = key.split('.');
                let value = i18n;
                keys.forEach((k) => {
                    value = value[k];
                });

                if (value) {
                    let textSpan = element.querySelector('span.z-10');
                    if (textSpan) {
                        textSpan.textContent = value;
                    }
                }
            });
        });
    };

    document.addEventListener('languageChanged', updateSectionTitles);
</script>
