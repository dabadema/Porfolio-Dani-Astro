---
const currentLanguage =
    typeof localStorage !== 'undefined' ? localStorage.getItem('language') || 'es' : 'es';
---

<button
    id="language-toggle"
    class="relative inline-flex items-center justify-center p-2 text-md font-semibold bg-black/5 rounded-full hover:bg-black/10 dark:hover:bg-white/10 transition-all duration-200 hover:scale-110"
    aria-label="Switch Language"
>
    <span id="language-text">🇪🇸</span>
</button>

<script>
    import es from '../i18n/es.json';
    import en from '../i18n/en.json';

    const translations = { es, en };
    const languageToggle = document.getElementById('language-toggle');
    const languageText = document.getElementById('language-text');

    function updateButtonText() {
        const currentLang = localStorage.getItem('language') || 'es';
        if (languageText) {
            languageText.textContent = currentLang === 'es' ? '🇪🇸' : '🇺🇸';
        }
    }

    const updateTexts = () => {
        const currentLang = localStorage.getItem('language') || 'es';
        const currentTranslations = translations[currentLang as keyof typeof translations];

        document.querySelectorAll('[data-i18n-key]').forEach((element) => {
            const key = element.getAttribute('data-i18n-key');
            if (key) {
                try {
                    const value = key
                        .split('.')
                        .reduce((obj: any, k) => obj?.[k], currentTranslations);
                    if (value) {
                        element.textContent = value;
                    }
                } catch (error) {
                    console.warn(`Translation key not found: ${key}`);
                }
            }
        });
    };

    updateButtonText();
    updateTexts();

    languageToggle?.addEventListener('click', () => {
        const currentLang = localStorage.getItem('language') || 'es';
        const newLanguage = currentLang === 'es' ? 'en' : 'es';
        localStorage.setItem('language', newLanguage);
        updateButtonText();
        updateTexts();

        const typewriterElement = document.getElementById('typewriter');
        if (typewriterElement) {
            typewriterElement.textContent = '';
            void typewriterElement.offsetHeight;

            setTimeout(() => {
                const event = new Event('DOMContentLoaded');
                document.dispatchEvent(event);
            }, 100);
        }
    });
</script>
