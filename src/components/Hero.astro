---
import LinkedInIcon from '../components/icons/LinkedIn.astro';
import MailIcon from '../components/icons/Mail.astro';
import SocialPill from '../components/SocialPill.astro';
import GitHubIcon from './icons/GitHubIcon.astro';
import Linktree from './icons/Linktree.astro';
import es from '../i18n/es.json';
import en from '../i18n/en.json';

const personalImageAlt = 'Daniel Baena';
const { currentLocale } = Astro;
console.log('URL actual:', Astro.url.pathname);
console.log('Locale detectado:', currentLocale);
---

<div class="max-w-xl mb-16">
    <div class="flex gap-4 mb-4 justify-center">
        <img
            class="rounded-full shadow-lg size-40"
            src="/Perfil-DBM_optimized.webp"
            alt={personalImageAlt}
        />
        <a
            href="https://www.linkedin.com/in/dbaenademadariaga/"
            target="_blank"
            rel="noopener"
            class="flex items-center transition
      md:justify-center md:hover:scale-105"
        >
            <!-- <Badge>Preparado para ayudarte!</Badge> -->
        </a>
    </div>
    <h1
        class="text-4xl text-center font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
    >
        <span id="typewriter"></span>
    </h1>
    <p
        class="mt-6 text-xl text-gray-800 text-pretty text-center
    dark:[&>strong]:text-yellow-200 dark:text-gray-300
    [&>strong]:text-yellow-500 [&>strong]:font-semibold"
    >
        Apasionado del mundo de las tecnologías. <br />
        <strong>Ingeniero, Programador y Gestor de proyectos.</strong>
        <br /> Trabajo en equipo, servicio y calidad como valores.
    </p>
    <nav class="flex flex-wrap gap-3 mt-6 justify-center">
        <SocialPill href="https://www.linkedin.com/in/dbaenademadariaga/">
            <LinkedInIcon class="size-4" />
            LinkedIn
        </SocialPill>
        <SocialPill href="https://github.com/dabadema">
            <GitHubIcon class="size-4" />
            GitHub
        </SocialPill>
        <SocialPill href="https://linktr.ee/dabadema">
            <Linktree class="size-4" />
            Linktree
        </SocialPill>
        <SocialPill href="mailto:dabadema7@hotmail.com">
            <MailIcon class="size-4" />
            Email
        </SocialPill>
    </nav>
</div>

<style>
    @keyframes blink {
        0% {
            opacity: 0;
        }
        50% {
            opacity: 1;
        }
        100% {
            opacity: 0;
        }
    }

    #typewriter::after {
        content: '|';
        animation: blink 0.9s infinite;
    }
</style>
<script define:vars={{ es, en }}>
    function getInitialLanguage() {
        // Si ya hay un idioma guardado en localStorage, usamos ese
        const storedLanguage = localStorage.getItem('language');
        if (storedLanguage) return storedLanguage;

        // Si no hay idioma guardado, detectamos el del navegador
        const browserLang = navigator.language.toLowerCase().split('-')[0];
        const defaultLanguage = browserLang === 'es' ? 'es' : 'en';

        // Guardamos el idioma detectado en localStorage
        localStorage.setItem('language', defaultLanguage);
        return defaultLanguage;
    }

    function getTranslations() {
        const language = getInitialLanguage();
        return language === 'es' ? es : en;
    }

    function typeWriter(i = 0, stage = 0) {
        const translations = getTranslations();
        const typewriterElement = document.getElementById('typewriter');
        if (!typewriterElement) return;

        const correctPrefix = translations.typewriter.prefix;
        const mistakeText = translations.typewriter.mistake;
        const fullText = translations.typewriter.final;

        switch (stage) {
            case 0:
                if (i < correctPrefix.length) {
                    typewriterElement.textContent = correctPrefix.slice(0, i + 1);
                    i++;
                    setTimeout(() => typeWriter(i, 0), 100);
                } else {
                    setTimeout(() => typeWriter(0, 1), 100);
                }
                break;

            case 1:
                if (i < mistakeText.length) {
                    typewriterElement.textContent = correctPrefix + mistakeText.slice(0, i + 1);
                    i++;
                    setTimeout(() => typeWriter(i, 1), 100);
                } else {
                    setTimeout(() => typeWriter(mistakeText.length, 2), 1000);
                }
                break;

            case 2:
                if (i > 0) {
                    typewriterElement.textContent = correctPrefix + mistakeText.slice(0, i - 1);
                    i--;
                    setTimeout(() => typeWriter(i, 2), 50);
                } else {
                    setTimeout(() => typeWriter(correctPrefix.length, 3), 200);
                }
                break;

            case 3:
                if (i < fullText.length) {
                    typewriterElement.textContent = fullText.slice(0, i + 1);
                    i++;
                    setTimeout(() => typeWriter(i, 3), 100);
                }
                break;
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        typeWriter();
    });
</script>
