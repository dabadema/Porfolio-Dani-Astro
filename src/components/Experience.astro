---
import ExperienceItem from '../components/ExperienceItem.astro';
import { getI18N } from '../i18n/utils';

const i18n = getI18N({ currentLocale: 'es' });

const JOBS = ['fullstack', 'india', 'project'];

const EXPERIENCE = JOBS.map((jobKey) => ({
    title: i18n.experience.jobs[jobKey as keyof typeof i18n.experience.jobs].title,
    description: i18n.experience.jobs[jobKey as keyof typeof i18n.experience.jobs].description,
    date: i18n.experience.jobs[jobKey as keyof typeof i18n.experience.jobs].date,
    link: jobKey === 'fullstack' ? 'https://arcadigital.app' : undefined,
    company: {
        name: jobKey === 'fullstack' ? 'Arca Digital' : 'Alfran',
        logo: jobKey === 'fullstack' ? '/IMAGOTIPO_VERDE_1.png' : '/logo-alfran.png',
        logoHeight: jobKey === 'fullstack' ? 'h-5' : 'h-6',
    },
    index: jobKey,
}));
---

<ol class="relative mt-16">
    {
        EXPERIENCE.map((experience) => (
            <li class="experience-item">
                <ExperienceItem {...experience} />
            </li>
        ))
    }
</ol>

<script>
    const updateExperienceContent = () => {
        const currentLocale = localStorage.getItem('language') || 'es';

        import(`../i18n/${currentLocale}.json`).then((translations) => {
            const i18n = translations.default;

            document.querySelectorAll('[data-i18n-key]').forEach((element) => {
                const key = element.getAttribute('data-i18n-key');
                if (!key) return;

                const keys = key.split('.');
                let value = i18n;
                keys.forEach((k) => {
                    value = value[k];
                });

                if (value) {
                    element.textContent = value;
                }
            });
        });
    };

    document.addEventListener('languageChanged', updateExperienceContent);
</script>
