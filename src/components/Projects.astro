---
import React from './icons/React.astro';
import Vite from './icons/Vite.astro';
import Redux from './icons/Redux.astro';
import SpringBoot from './icons/SpringBoot.astro';
import Link from './icons/Link.astro';
import LinkButton from './LinkButton.astro';
import GitHub from './icons/GitHub.astro';
import Java from './icons/Java.astro';
import JavaScript from './icons/JavaScript.astro';
import Docker from './icons/Docker.astro';
import JWT from './icons/JWT.astro';
import Vercel from './icons/Vercel.astro';
import PostgreSQL from './icons/PostgreSQL.astro';
import TypescriptIcon from './icons/TypescriptIcon.astro';
import ZodIcon from './icons/ZodIcon.astro';
import Node from './icons/Node.astro';
import Expressjs from './icons/Expressjs.astro';
import Tailwindcss from './icons/Tailwindcss.astro';
import ReactRouter from './icons/ReactRouter.astro';
import { getI18N } from '../i18n/utils';

const i18n = getI18N({ currentLocale: 'es' });

const TAGS = {
    REACT: {
        name: 'React',
        class: 'bg-black text-white',
        icon: React,
    },

    VITE: {
        name: 'Vite',
        class: 'bg-black text-white',
        icon: Vite,
    },

    TYPESCRIPT: {
        name: 'TypeScript',
        class: 'bg-black text-white',
        icon: TypescriptIcon,
    },

    ZOD: {
        name: 'Zod',
        class: 'bg-black text-white',
        icon: ZodIcon,
    },

    REDUX: {
        name: 'Redux',
        class: 'bg-black text-white',
        icon: Redux,
    },

    SPRINGBOOT: {
        name: 'SpringBoot',
        class: 'bg-black text-white',
        icon: SpringBoot,
    },

    GITHUB: {
        name: 'GitHub',
        class: 'bg-black text-white',
        icon: GitHub,
    },

    JAVA: {
        name: 'Java',
        class: 'bg-black text-white',
        icon: Java,
    },

    JAVASCRIPT: {
        name: 'JavaScript',
        class: 'bg-black text-white',
        icon: JavaScript,
    },

    DOCKER: {
        name: 'Docker',
        class: 'bg-black text-white',
        icon: Docker,
    },

    JWT: {
        name: 'JWT',
        class: 'bg-black text-white',
        icon: JWT,
    },

    VERCEL: {
        name: 'Vercel',
        class: 'bg-black text-white',
        icon: Vercel,
    },

    POSTGRESQL: {
        name: 'PostgreSQL',
        class: 'bg-black text-white',
        icon: PostgreSQL,
    },
    NODE: {
        name: 'Node',
        class: 'bg-black text-white',
        icon: Node,
    },
    EXPRESS: {
        name: 'Express',
        class: 'bg-black text-white',
        icon: Expressjs,
    },
    TAILWINDCSS: {
        name: 'TailwindCSS',
        class: 'bg-black text-white',
        icon: Tailwindcss,
    },
    REACTROUTER: {
        name: 'RouterDOM',
        class: 'bg-black text-white',
        icon: ReactRouter,
    },
};

const PROJECTS = [
    {
        key: 'product_manager',
        image: './projects/Administrador_Productos_mock.webp',
        link: 'https://product-manager-frontend-omega.vercel.app/',
        frontend: 'https://github.com/dabadema/Product_manager_frontend',
        backend: 'https://github.com/dabadema/Product_manager_backend',
        tags: [
            TAGS.REACT,
            TAGS.TYPESCRIPT,
            TAGS.TAILWINDCSS,
            TAGS.REACTROUTER,
            TAGS.NODE,
            TAGS.EXPRESS,
            TAGS.POSTGRESQL,
            TAGS.VERCEL,
            TAGS.ZOD,
            TAGS.VITE,
        ],
    },
    {
        key: 'cryptocurrent',
        image: './projects/crypto_screenshot_reduced.webp',
        image2: '',
        link: 'https://cryptocurrentapp.netlify.app/',
        codigo: 'https://github.com/dabadema/React-y-Typescript/tree/main/crypto-react-typescript',
        tags: [TAGS.REACT, TAGS.TYPESCRIPT, TAGS.TAILWINDCSS, TAGS.ZOD, TAGS.VITE],
    },
];
---

<div class="flex flex-col gap-y-16">
    {
        PROJECTS.map(({ key, image, image2, tags, link, backend, frontend, codigo }) => (
            <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
                <div class="w-full md:w-1/2 flex flex-col gap-4">
                    {/* Tarjeta para la primera imagen */}
                    <div class="relative flex flex-col items-center transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
                        <img
                            alt="Foto 1"
                            class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
                            loading="lazy"
                            src={image}
                        />
                    </div>

                    {/* Tarjeta para la segunda imagen (si existe) */}
                    {image2 && (
                        <div class="relative flex flex-col items-center transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
                            <img
                                alt="Foto 2"
                                class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
                                loading="lazy"
                                src={image2}
                            />
                        </div>
                    )}
                </div>

                <div class="w-full md:w-1/2 md:max-w-lg ">
                    <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
                        <span data-i18n-key={`projects.${key}.title`}>
                            {(i18n.projects[key as keyof typeof i18n.projects] as any).title}
                        </span>
                    </h3>
                    <div class="flex flex-wrap mt-2">
                        <div class="mt-2 text-gray-700 dark:text-gray-400 text-justify">
                            {(
                                i18n.projects[key as keyof typeof i18n.projects] as any
                            ).description.map((paragraph: string, index: number) => (
                                <p data-i18n-key={`projects.${key}.description.${index}`}>
                                    {paragraph}
                                </p>
                            ))}
                        </div>
                        <ul class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-4">
                            {tags.map((tag) => (
                                <li>
                                    <span
                                        class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
                                    >
                                        <tag.icon class="size-4" />
                                        {tag.name}
                                    </span>
                                </li>
                            ))}
                        </ul>

                        <footer class="flex items-end justify-start mt-4 gap-x-4">
                            {backend && (
                                <LinkButton href={backend}>
                                    <GitHub class="size-6" />
                                    <span data-i18n-key="projects.links.backend">Backend</span>
                                </LinkButton>
                            )}

                            {codigo && (
                                <LinkButton href={codigo}>
                                    <GitHub class="size-5" />
                                    <span data-i18n-key="projects.links.code">Código</span>
                                </LinkButton>
                            )}

                            {frontend && (
                                <LinkButton href={frontend}>
                                    <GitHub class="size-5" />
                                    <span data-i18n-key="projects.links.frontend">Frontend</span>
                                </LinkButton>
                            )}

                            {link && (
                                <LinkButton href={link}>
                                    <Link class="size-4" />
                                    <span data-i18n-key="projects.links.link">Enlace</span>
                                </LinkButton>
                            )}
                        </footer>
                    </div>
                </div>
            </article>
        ))
    }
</div>

<script>
    const updateProjectsContent = () => {
        const currentLocale = localStorage.getItem('language') || 'es';

        import(`../i18n/${currentLocale}.json`).then((translations) => {
            const i18n = translations.default;

            document.querySelectorAll('[data-i18n-key]').forEach((element) => {
                const key = element.getAttribute('data-i18n-key');
                if (!key) return;

                const keys = key.split('.');
                let value = i18n;
                keys.forEach((k) => {
                    value = value[k];
                });

                if (value) {
                    element.textContent = value;
                }
            });
        });
    };

    document.addEventListener('languageChanged', updateProjectsContent);

    updateProjectsContent();
</script>
